# =========================================================
# SunPower Solutions Solar ERP — Environment Configuration
# =========================================================

# Backend REST API Base URL
# Point this to your backend server (e.g. Node/Express, FastAPI, Django)
VITE_API_BASE_URL=http://localhost:5000/api

# =========================================================
# EmailJS Transactional Notification Service (Optional)
# Create a free account at https://www.emailjs.com/
# =========================================================
VITE_EMAILJS_SERVICE_ID=service_sunpower_erp
VITE_EMAILJS_TEMPLATE_ID=template_staff_notification
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
